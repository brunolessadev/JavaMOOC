<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>helsinki.mooc</groupId>
    <artifactId>part06-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Java MOOC - Part 06</name>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>mooc-java-programming-i/part06-Part06_01.Menu.src</source>
                                <source>JavaMOOC/mooc-java-programming-i/part06-Part06_02.Stack.src</source>
                                <source>mooc-java-programming-i/part06-Part06_03.MessagingService.src</source>
                                <source>mooc-java-programming-i/part06-Part06_04.PrintingACollection.src</source>
                                <source>mooc-java-programming-i/part06-Part06_05.SantasWorkshop.src</source>
                                <source>mooc-java-programming-i/part06-Part06_06.LongestInCollection.src</source>
                                <source>mooc-java-programming-i/part06-Part06_07.HeightOrder.src</source>
                                <source>mooc-java-programming-i/part06-Part06_08.CargoHold.src</source>
                                <source>mooc-java-programming-i/part06-Part06_09.SimpleDictionary.src</source>
                                <source>mooc-java-programming-i/part06-Part06_10.TodoList.src</source>
                                <source>mooc-java-programming-i/part06-Part06_11.Averages.src</source>
                                <source>mooc-java-programming-i/part06-Part06_12.JokeManager.src</source>
                                <source>mooc-java-programming-i/part06-Part06_13.Exercises.src</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>